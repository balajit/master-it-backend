# master-it-backend — Environment Variables
# Copy this file to .env and fill in the values.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your values
#   uv run scripts/init_env.py --env test

# ── Database ─────────────────────────────────────────────────────────────────
# Test environment (docker-compose postgres_test, port 5433)
DATABASE_URL=postgresql+asyncpg://postgres_user:<replace_with_strong_password>@localhost:5433/learning_platform_testing

# Production environment (docker-compose postgres_prod, port 5432)
# DATABASE_URL=postgresql+asyncpg://postgres_user:<replace_with_strong_password>@localhost:5432/learning_platform

# ── Auth ─────────────────────────────────────────────────────────────────────
# Secret key used to sign JWT tokens
JWT_SECRET=<replace_with_long_random_secret>

# Google OAuth (optional — only needed if Google login is enabled)
# GOOGLE_CLIENT_ID=your_google_client_id

# ── Learning Platform (lp) SQLite DB ─────────────────────────────────────────
# The learning_platform sub-app stores study plans in a separate SQLite database.
# Leave as default unless you change the path in learning_platform config.
# LP_DATABASE_URL=sqlite+aiosqlite:///./learning_platform.db

# ── Storage (MinIO / S3) ──────────────────────────────────────────────────────
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minio_admin
# MINIO_SECRET_KEY=secure_minio_password
# MINIO_BUCKET=documents

# ── Observability (optional) ──────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
